{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learning-atlas.local/experiments/E001/event.schema.json",
  "title": "E001 AI-mediated stewardship observation event",
  "description": "Append-only, learner-reviewable observation evidence for E001. Scored assertions are provenance-typed; learner-state inferences use inference.schema.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "eventId", "eventType", "occurredAt", "recordedAt", "learnerRef", "observer", "objective", "task", "evidenceLane", "assistanceEnvelope", "stewardshipActions", "outcome", "accessibility", "governance"],
  "properties": {
    "schemaVersion": { "const": "0.2.0" },
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "enum": ["observation", "correction"] },
    "occurredAt": { "type": "string", "format": "date-time" },
    "recordedAt": { "type": "string", "format": "date-time" },
    "learnerRef": { "type": "string", "minLength": 8, "description": "A pilot-specific pseudonymous reference; never an email or display name." },
    "observer": { "$ref": "#/$defs/observer" },
    "objective": { "$ref": "#/$defs/objective" },
    "task": { "$ref": "#/$defs/task" },
    "evidenceLane": { "enum": ["accessible-independent", "ai-assisted", "supervisory-recovery"] },
    "assistanceEnvelope": { "$ref": "#/$defs/assistanceEnvelope" },
    "systemProvenance": { "$ref": "#/$defs/systemProvenance" },
    "preAdvice": { "$ref": "#/$defs/judgment" },
    "intervention": { "$ref": "#/$defs/intervention" },
    "postAdvice": { "$ref": "#/$defs/postAdvice" },
    "stewardshipActions": { "type": "array", "uniqueItems": true, "items": { "enum": ["verify-source", "check-tool", "compare-alternative", "repair", "tool-switch", "human-escalation", "uncertainty-escalation", "contest", "none-observed"] } },
    "outcome": { "$ref": "#/$defs/outcome" },
    "accessibility": { "$ref": "#/$defs/accessibility" },
    "governance": { "$ref": "#/$defs/governance" }
  },
  "allOf": [
    { "if": { "properties": { "evidenceLane": { "const": "ai-assisted" } } }, "then": { "required": ["systemProvenance", "preAdvice", "intervention", "postAdvice"] } },
    { "if": { "properties": { "eventType": { "const": "correction" } } }, "then": { "properties": { "governance": { "required": ["correctionOf", "correctionReason"] } } } }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$", "description": "Digest of content retained outside the event, if retention is justified." },
    "observer": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "captureMethod", "profileVersion"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["application", "instrument", "human-reviewer", "learner"] },
        "captureMethod": { "enum": ["telemetry", "learner-report", "reviewer-coded", "instrument-scored", "mixed"] },
        "profileVersion": { "type": "string", "minLength": 1 }
      }
    },
    "objective": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "targetCapability"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "targetCapability": { "type": "string", "minLength": 1 } }
    },
    "task": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "formId", "trialId", "conditions"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "formId": { "type": "string", "minLength": 1 }, "trialId": { "type": "string", "minLength": 1 }, "rubricVersion": { "type": "string" },
        "conditions": {
          "type": "object", "additionalProperties": false,
          "required": ["deliveryMode", "language", "timeLimitSeconds"],
          "properties": { "deliveryMode": { "enum": ["online", "in-person", "hybrid"] }, "language": { "type": "string", "minLength": 2 }, "timeLimitSeconds": { "type": ["integer", "null"], "minimum": 0 }, "resourcePolicyVersion": { "type": "string" } }
        }
      }
    },
    "assistanceEnvelope": {
      "type": "object", "additionalProperties": false,
      "required": ["accessibleBaseline", "functions", "toolsAllowed", "toolsAvailable", "toolsDeclaredUsed", "toolsObservedUsed", "useEvidenceBasis", "classificationStatus", "classificationAssertedBy", "substantiveGenerationState"],
      "properties": {
        "accessibleBaseline": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "functions": { "type": "array", "uniqueItems": true, "items": { "enum": ["access-restoration", "representation", "expression", "executive-support", "substantive-cognitive-delegation", "unknown"] } },
        "toolsAllowed": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "toolsAvailable": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "toolsDeclaredUsed": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "toolsObservedUsed": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "useEvidenceBasis": { "enum": ["telemetry", "learner-report", "reviewer-observation", "mixed", "unknown"] },
        "classificationStatus": { "enum": ["unreviewed", "learner-confirmed", "disputed", "unknown"] },
        "classificationAssertedBy": { "type": "string", "minLength": 1 },
        "substantiveGenerationState": { "enum": ["not-available", "available-declared-not-used", "used", "unknown"] }
      }
    },
    "systemProvenance": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "model", "modelVersion", "adviceVersion", "promptVersion", "knownUncertainty"],
      "properties": { "provider": { "type": "string", "minLength": 1 }, "model": { "type": "string", "minLength": 1 }, "modelVersion": { "type": "string", "minLength": 1 }, "adviceVersion": { "type": "string", "minLength": 1 }, "promptVersion": { "type": "string", "minLength": 1 }, "retrievalProvenance": { "type": "array", "items": { "type": "string" } }, "knownUncertainty": { "type": "string", "minLength": 1 } }
    },
    "selfReportedConfidence": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "scaleMin", "scaleMax", "scaleVersion", "elicitationMethod"],
      "properties": { "value": { "type": "number" }, "scaleMin": { "type": "number" }, "scaleMax": { "type": "number" }, "scaleVersion": { "type": "string", "minLength": 1 }, "elicitationMethod": { "type": "string", "minLength": 1 } }
    },
    "judgment": {
      "type": "object", "additionalProperties": false,
      "required": ["responseDigest", "judgment", "assertedBy", "evidenceRuleVersion", "scoredAt"],
      "properties": { "responseDigest": { "$ref": "#/$defs/digest" }, "judgment": { "enum": ["correct", "partial", "incorrect", "not-yet-scorable"] }, "selfReportedConfidence": { "$ref": "#/$defs/selfReportedConfidence" }, "assertedBy": { "type": "string", "minLength": 1 }, "evidenceRuleVersion": { "type": "string", "minLength": 1 }, "scoredAt": { "type": "string", "format": "date-time" }, "rationaleDigest": { "$ref": "#/$defs/digest" } }
    },
    "intervention": {
      "type": "object", "additionalProperties": false,
      "required": ["ordering", "adviceState", "severity", "adviceDigest", "cues"],
      "properties": { "ordering": { "enum": ["self-first", "advice-first"] }, "adviceState": { "enum": ["correct", "incomplete", "plausible-incorrect", "not-defensibly-scorable"] }, "severity": { "type": "integer", "minimum": 0, "maximum": 4 }, "adviceDigest": { "$ref": "#/$defs/digest" }, "cues": { "type": "array", "uniqueItems": true, "items": { "enum": ["provenance", "uncertainty", "justification-prompt", "none"] } } }
    },
    "postAdvice": {
      "type": "object", "additionalProperties": false,
      "required": ["responseDigest", "disposition", "acceptedElementRefs", "rejectedElementRefs"],
      "properties": { "responseDigest": { "$ref": "#/$defs/digest" }, "selfReportedConfidence": { "$ref": "#/$defs/selfReportedConfidence" }, "disposition": { "enum": ["accepted", "rejected", "edited", "escalated"] }, "acceptedElementRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }, "rejectedElementRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }, "rationaleDigest": { "$ref": "#/$defs/digest" } }
    },
    "outcome": {
      "type": "object", "additionalProperties": false,
      "required": ["scoringStatus", "delaySeconds", "timeHorizon", "transferDistance", "supportState"],
      "properties": {
        "scoringStatus": { "enum": ["scored", "unscored"] }, "score": { "type": "number", "minimum": 0, "maximum": 1 }, "correctness": { "enum": ["correct", "partial", "incorrect", "not-scorable"] }, "severityWeightedError": { "type": ["number", "null"], "minimum": 0 },
        "scoringAssertion": { "type": "object", "additionalProperties": false, "required": ["assertedBy", "rubricVersion", "evidenceRuleVersion", "scoredAt"], "properties": { "assertedBy": { "type": "string", "minLength": 1 }, "rubricVersion": { "type": "string", "minLength": 1 }, "evidenceRuleVersion": { "type": "string", "minLength": 1 }, "scoredAt": { "type": "string", "format": "date-time" } } },
        "delaySeconds": { "type": "integer", "minimum": 0 }, "timeHorizon": { "enum": ["immediate", "delayed"] }, "transferDistance": { "enum": ["same-task", "near", "far", "authentic"] }, "supportState": { "enum": ["accessible-independent", "ai-assisted", "supervisory-recovery"] }
      },
      "allOf": [{ "if": { "properties": { "scoringStatus": { "const": "scored" } } }, "then": { "required": ["score", "correctness", "severityWeightedError", "scoringAssertion"] } }]
    },
    "accessibility": {
      "type": "object", "additionalProperties": false,
      "required": ["accessSupportsPreserved", "classificationReviewedByLearner"],
      "properties": { "accessSupportsPreserved": { "const": true }, "classificationReviewedByLearner": { "type": "boolean" }, "barrierNote": { "type": "string", "description": "Optional task-context barrier, not a diagnosis." } }
    },
    "governance": {
      "type": "object", "additionalProperties": false,
      "required": ["collectionPurpose", "stakes", "permittedUses", "prohibitedUses", "consentVersion", "learnerVisible", "contestable", "retentionUntil"],
      "properties": {
        "collectionPurpose": { "const": "E001 research pilot" }, "stakes": { "const": "low" },
        "permittedUses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["pilot-analysis", "learner-review", "instrument-improvement"] } },
        "prohibitedUses": { "type": "array", "minItems": 4, "uniqueItems": true, "items": { "enum": ["learner-ranking", "credentialing", "employment-decision", "silent-mastery-update", "diagnosis", "disciplinary-action"] } },
        "consentVersion": { "type": "string", "minLength": 1 }, "learnerVisible": { "const": true }, "contestable": { "const": true }, "retentionUntil": { "type": "string", "format": "date-time" }, "correctionOf": { "type": "string", "format": "uuid" }, "correctionReason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
